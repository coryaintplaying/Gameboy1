void loop() {
  int xVal = analogRead(JOYSTICK_X); // MOVED: Read joystick at the start of loop so both Menu and Game can use it
  int yVal = analogRead(JOYSTICK_Y); // MOVED: Read joystick at the start of loop
  bool bVal = digitalRead(JOYSTICK_B); // MOVED: Read button at the start of loop

  if (chosen_game == -1) { // ADDED: Only run the menu when no game is selected (make sure chosen_game starts at -1)
    //=============================//
    //=============MENU============//
    //=============================//
    prev_selected_item = selected_item - 1;
    if (prev_selected_item < 0) { prev_selected_item = number_items - 1; }
    
    next_selected_item = selected_item + 1;
    if (next_selected_item >= number_items) { next_selected_item = 0; }

    if ((yVal > 850) && (down_clicked == 1)) { // Down
      selected_item -= 1;
      if (selected_item < 0) { selected_item = number_items - 1; }
      down_clicked = 0;
    } 
    else if ((yVal < 150) && (up_clicked == 1)) { // UP
      selected_item += 1;
      if (selected_item >= number_items) { selected_item = 0; }
      up_clicked = 0;
    }

    if ((yVal < 850) && (down_clicked == 0)) { down_clicked = 1; } // reset Down
    if ((yVal > 150) && (up_clicked == 0)) { up_clicked = 1; }     // reset UP

    if (!bVal) {
      chosen_game = selected_item;
      Serial.print(bVal);
      Serial.println(menu_items[chosen_game]);
      delay(200);
    }

    // CHANGED: Replaced the entire u8g.firstPage() / do-while loop with Adafruit_SSD1306 commands below
    display.clearDisplay(); // CHANGED: Clears the screen buffer (replaces u8g.firstPage)
    display.setTextColor(WHITE); // ADDED: Required for Adafruit_SSD1306 text to be visible
    display.setTextSize(1); // CHANGED: Replaces u8g.setFont(u8g_font_7x13)

    // previous item
    display.setCursor(4, 8); // CHANGED: Sets text X,Y coordinates (replaces draw() position)
    display.print(menu_items[prev_selected_item]); // CHANGED: Prints menu text directly

    // selected item
    display.setCursor(4, 28); // CHANGED: Sets text X,Y coordinates for middle item
    display.print("> "); // ADDED: Highlights selected item since standard font has no bold version
    display.print(menu_items[selected_item]); // CHANGED: Prints selected menu text

    // next item
    display.setCursor(4, 48); // CHANGED: Sets text X,Y coordinates for bottom item
    display.print(menu_items[next_selected_item]); // CHANGED: Prints next menu text

    // CHANGED: Replaced u8g.drawBitmapP with display.drawBitmap (width in pixels instead of bytes, added WHITE color)
    display.drawBitmap(0, 22, scrolloutline, 120, 21, WHITE); // CHANGED: 120/8 became 120 pixels wide
    display.drawBitmap(125, 0, scrollbar, 8, 64, WHITE); // CHANGED: 8/8 became 8 pixels wide

    display.display(); // CHANGED: Pushes buffer to the screen (replaces while(u8g.nextPage()))
    delay(50);
  } // ADDED: Closes the Menu if-block
  else if (chosen_game == 0) { // ADDED: Only run Snake Game when game 0 is chosen from the menu
    //=============================//
    //========GAME1:SnakeGame======//
    //=============================//
    delay(80);
    
    if (xVal > 850 && snake_dir != 2) { // Right
      snake_dir = 0;
    } else if (xVal < 150 && snake_dir != 0) { // Left
      snake_dir = 2;
    } else if (yVal > 850 && snake_dir != 1) { // Down
      snake_dir = 3;
    } else if (yVal < 150 && snake_dir != 3) { // UP
      snake_dir = 1;
    }

    for (int i = snake_length - 1; i > 0; i--) {
      snake_x[i] = snake_x[i - 1];
      snake_y[i] = snake_y[i - 1];
    }

    switch (snake_dir) {
      case 0: snake_x[0]++; break;
      case 1: snake_y[0]--; break;
      case 2: snake_x[0]--; break;
      case 3: snake_y[0]++; break;
    }

    if (snake_x[0] < 0) {
      snake_x[0] = display.width() / 8 - 1;
    } else if (snake_x[0] >= display.width() / 8) {
      snake_x[0] = 0;
    }
    if (snake_y[0] < 0) {
      snake_y[0] = display.height() / 8 - 1;
    } else if (snake_y[0] >= display.height() / 8) {
      snake_y[0] = 0;
    }

    // Eat Apple
    if (snake_x[0] == food_x && snake_y[0] == food_y) {
      if (snake_length < SNAKE_MAX_LENGTH) {
        snake_length++;
      }
      score = score + 1;
      food_x = random(0, display.width() / 8);
      food_y = random(0, display.height() / 8);
    }

    for (int i = 1; i < snake_length; i++) {
      if (snake_x[0] == snake_x[i] && snake_y[0] == snake_y[i]) {
        gameOver();
        Reset();
        chosen_game = -1; // ADDED: Sends you back to the menu after losing
      }
    }

    display.clearDisplay();
    drawSnake();
    drawFood();
    display.display();
  } // ADDED: Closes the Snake Game else-if block
}

