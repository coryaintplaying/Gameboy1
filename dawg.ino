void setup(){
  Wire.begin();
  u8g.setColorIndex(1); //(White)

  u8g.firstPage();
  do {
    u8g.setFont(u8g_font_courB14); //u8g_font_courB14 is a nice, bold 14px high font
    u8g.drawStr(30, 37, "Gameb0y"); 
  } while (u8g.nextPage());

  delay(5000);
}

void loop(){
  u8g.firstPage();
