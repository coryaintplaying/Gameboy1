//====================================================================
//=======================MAIN=========================================
//====================================================================
const int number_items = 3; //number of items
int selected_item = 0; //which item is selected
int prev_selected_item; //previous item before the selected item
int next_selected_item; //next item after the selected item


const unsigned char* bitmap_icons[3] = {
	bird_icon,
	car_icon,
	snake_icon,
};


char menu_items[number_items] [3] = {
	{"Bird"},
	{"Car"},
	{"Snake"}
};



void setup(){
  Wire.begin();
  u8g.setColorIndex(1); //(White)

  u8g.firstPage();
  do {
    u8g.setFont(u8g_font_courB14);
    u8g.drawStr(30, 37, "Gameb0y"); 
  } while (u8g.nextPage());

  // delay(5000);
}



void loop(){

  prev_selected_item = selected_item - 1
  if (prev_selected_item<0) {prev_selected_item=number_items-1;}
  next_selected_item = selected_item + 1
  if (next_selected_item>=number_items) {next_selected_item-0;}
  u8g.firstPage();
  do {
    // previous item
    u8g.setFont(u8g_font_7x13);
    u8g.drawStr(24,16,menu_items[prev_selected_item]);
    u8g.drawBitmapP(4, 4, 16/8, 13, bitmap_icons[prev_selected_item]);

    //selected item
    u8g.setFont(u8g_font_7x13B);
    u8g.drawStr(24,37,menu_items[selected_item]);
    u8g.drawBitmapP(4, 26, 16/8, 12, bitmap_icons[selected_item]);
 
    //next item    
    u8g.setFont(u8g_font_7x13);
    u8g.drawStr(24,58,menu_items[next_selected_item]);
    u8g.drawBitmapP(4, 47, 16/8, 14, bitmap_icons[next_selected_item]);

		u8g.drawBitmapP(0, 22, 120/8, 21, scrolloutline);
    u8g.drawBitmapP(125, 0, 8/8, 64, scrollbar);
  
  } while (u8g.nextPage());

  delay(100);
}

