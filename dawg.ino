//=======================MAIN=========================================
//====================================================================
const int nitems = 3; //number of items
int sitem = 0; //which item is selected



char menu_items[nitems] [3] = {
	{"Bird"},
	{"Car"},
	{"Snake"}
};



void setup(){
  Wire.begin();
  u8g.setColorIndex(1); //(White)

  u8g.firstPage();
  do {
    u8g.setFont(u8g_font_courB14); //u8g_font_courB14 is a nice, bold 14px high font
    u8g.drawStr(30, 37, "Gameb0y"); 
  } while (u8g.nextPage());

  delay(5000);
}



void loop(){
  u8g.firstPage();
  do {
    // previous item
    u8g.setFont(u8g_font_7x13);
    u8g.drawStr(24,16,menu_items[0]);
    u8g.drawBitmapP(4, 4, 16/8, 13, menu_items[0]);

    //selected item
    u8g.setFont(u8g_font_7x13B);
    u8g.drawStr(24,37,menu_items[1]);
    u8g.drawBitmapP(4, 26, 16/8, 12, menu_items[1]);
 
    //next item    
    u8g.setFont(u8g_font_7x13);
    u8g.drawStr(24,58,menu_items[2]);
    u8g.drawBitmapP(4, 47, 16/8, 14, menu_items[2]);

		u8g.drawBitmapP(0, 22, 120/8, 21, epd_bitmap_scrolloutline);
    u8g.drawBitmapP(125, 0, 8/8, 64, epd_bitmap_scrollbar);
  
  } while (u8g.nextPage());

  delay(100);
}

